{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@pages/*": [
        "./src/pages/*"
      ],
      "@components/*": [
        "./src/components/*"
      ],
      "@fixtures/*": [
        "./src/fixtures/*"
      ],
      "@data/*": [
        "./src/data/*"
      ],
      "@api/*": [
        "./src/api/*"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "src",
    "tests",
    "playwright.config.ts"
  ]
}
